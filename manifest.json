{
  "manifest_version": 3,
  "name": "YT-to-Gemini Summarizer Helper",
  "version": "1.2.9",
  "description": "Hover a YouTube thumbnail; a global hotkey copies the URL and sends it to the Gemini app (Windows/macOS/Linux).",
  "permissions": ["clipboardWrite", "storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
